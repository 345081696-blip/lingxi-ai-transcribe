{
  "name": "local-transcribe-studio",
  "version": "0.2.35",
  "description": "本机语音转写工坊：录制/导入音视频，本地 AI 转写、整理并导出文档（Windows 版）。",
  "main": "src/main.js",
  "author": "Local",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis",
    "fetch:models": "python scripts/fetch_models.py small",
    "dist:win": "python scripts/fetch_models.py small && electron-builder --win nsis",
    "postinstall": "node scripts/patch-electron-builder.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "42.3.3",
    "electron-builder": "26.15.0"
  },
  "overrides": {
    "@noble/hashes": "1.3.3"
  },
  "build": {
    "appId": "local.transcribe.studio",
    "productName": "本机语音转写工坊",
    "directories": {
      "output": "../../outputs/release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "native/bin/native-recorder",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extra/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "python",
        "to": "python"
      },
      {
        "from": "python-embed",
        "to": "python-embed",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "本机语音转写工坊-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ]
    }
  }
}
